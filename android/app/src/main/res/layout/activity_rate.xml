<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0D12"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_simple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/gameIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/background_game_thumb"
                android:gravity="center"
                android:text="GAME"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Reactoonz"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Playngo · 95% · High risk"
                android:textColor="#8E7A84"
                android:textSize="10sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#35202A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Your rating"
                android:textColor="#8E7A84"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/starRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/star1"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:srcCompat="@drawable/icon_star" />

                <ImageButton
                    android:id="@+id/star2"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:srcCompat="@drawable/icon_star" />

                <ImageButton
                    android:id="@+id/star3"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:srcCompat="@drawable/icon_star" />

                <ImageButton
                    android:id="@+id/star4"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:srcCompat="@drawable/icon_star" />

                <ImageButton
                    android:id="@+id/star5"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    app:srcCompat="@drawable/icon_star" />
            </LinearLayout>

            <TextView
                android:id="@+id/ratingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a star to rate"
                android:textColor="#6F5C65"
                android:textSize="9sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:background="#35202A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/background_rating_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/background_info_circle"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Communiting Rate"
                        android:textColor="#BFA9B3"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/communityRatingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ ★ ★ ★ ☆   4.0 - 252 votes"
                        android:textColor="#E91E83"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/submitRatingButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/background_sumbit_disabled"
                android:enabled="false"
                android:text="Submit rating"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:textColor="#7D6872"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>