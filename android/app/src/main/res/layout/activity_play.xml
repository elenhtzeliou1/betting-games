<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0D12">

    <!-- ═══════════════════════════════════════════════════════════════
         TOOLBAR
    ═══════════════════════════════════════════════════════════════════ -->

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_simple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/toolbarBalance"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="— FUN"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/background_balance_pill"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="14dp" />

    <!-- ═══════════════════════════════════════════════════════════════
         SCROLLABLE CONTENT
    ═══════════════════════════════════════════════════════════════════ -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════════════════
                 GAME HERO — three states stacked in a FrameLayout.
                 STATE 1 heroDefault  — game icon (initial)
                 STATE 2 heroLoading  — pink spinner while bet is in-flight
                 STATE 3 heroResult   — win / loss / jackpot outcome
            ════════════════════════════════════════════════════════════ -->

            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#200C15">

                <!-- ─── STATE 1 : DEFAULT ─────────────────────────── -->
                <LinearLayout
                    android:id="@+id/heroDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/background_game_thumb"
                        android:gravity="center"
                        android:text="GAME"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ─── STATE 2 : LOADING ─────────────────────────── -->
                <LinearLayout
                    android:id="@+id/heroLoading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:indeterminateTint="#E91E83" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Placing bet…"
                        android:textColor="#8E7A84"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- ─── STATE 3 : RESULT ──────────────────────────── -->
                <LinearLayout
                    android:id="@+id/heroResult"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResultTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOU WON!"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvResultPayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="+0.00 FUN"
                        android:textColor="#E91E83"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvResultBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Balance: —"
                        android:textColor="#8E7A84"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Risk badge -->
                <TextView
                    android:id="@+id/tvRiskBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="High"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#FF4444"
                    android:background="@drawable/background_risk_badge" />

            </FrameLayout>

            <!-- ───────────────────────────────────────────────────────
                 GAME TITLE + META
            ─────────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvGameName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGameMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Provider · $$$"
                    android:textColor="#8E7A84"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ───────────────────────────────────────────────────────
                 STAT CARDS  (Min bet | Max bet | Jackpot)
                 Min bet and Max bet cards are tappable shortcuts :)
            ─────────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="6dp">

                <!-- Min bet — tap to set bet to minimum -->
                <LinearLayout
                    android:id="@+id/cardMinBet"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_rating_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Min bet"
                        android:textColor="#8E7A84"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvMinBetValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1.00 FUN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="6dp" android:layout_height="match_parent" />

                <!-- Max bet — tap to set bet to maximum -->
                <LinearLayout
                    android:id="@+id/cardMaxBet"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_rating_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Max bet"
                        android:textColor="#8E7A84"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvMaxBetValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="100.00 FUN"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="6dp" android:layout_height="match_parent" />

                <!-- Jackpot — display only, not  :( -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_rating_card"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jackpot"
                        android:textColor="#8E7A84"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvJackpotValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10x"
                        android:textColor="#E91E83"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ───────────────────────────────────────────────────────
                 DIVIDER
            ─────────────────────────────────────────────────────────── -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="10dp"
                android:background="#35202A" />

            <!-- ───────────────────────────────────────────────────────
                 BET CONTROL
            ─────────────────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your bet"
                    android:textColor="#8E7A84"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnBetMinus"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="−"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/background_rating_card"
                        app:backgroundTint="@null"
                        android:padding="0dp"
                        android:textAllCaps="false" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvBetAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.00"
                            android:textColor="#FFFFFF"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginBottom="4dp"
                            android:layout_gravity="bottom"
                            android:text="FUN"
                            android:textColor="#8E7A84"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnBetPlus"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="+"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/background_rating_card"
                        app:backgroundTint="@null"
                        android:padding="0dp"
                        android:textAllCaps="false" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBetHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Min: 1.00  ·  Max: 100.00"
                    android:textColor="#6F5C65"
                    android:textSize="10sp" />

                <!-- ─────────────────────────────────────────────────
                     PLACE BET button && in-button spinner overlay.
                     FrameLayout lets the ProgressBar sit centred on
                     top of the Button without extra padding tricks.
                ──────────────────────────────────────────────────── -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btnPlaceBet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Place bet"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:background="@drawable/background_submit_enabled"
                        app:backgroundTint="@null" />

                    <!-- Spinner shown while bet is in-flight or during the cooldown -->
                    <ProgressBar
                        android:id="@+id/btnPlaceBetProgress"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>