<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fully rounded pill -->
    <corners android:radius="16dp" />

    <!-- Dark fill matching the app's card colour -->
    <solid android:color="#2D1520" />

    <!-- Subtle border so it reads as a distinct chip on the toolbar -->
    <stroke
        android:width="1.5dp"
        android:color="#5A3045" />

</shape>
